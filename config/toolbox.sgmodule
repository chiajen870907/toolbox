#!name=Toolbox
#!desc=本機腳本設定管理

[General]
force-http-engine-hosts = %APPEND% toolbox.com

[Script]
Toolbox = type=http-request,pattern=^https://toolbox[.]com(?:/.*)?$,script-path=https://raw.githubusercontent.com/chiajen870907/toolbox/main/toolbox.js,requires-body=true,timeout=20

[MITM]
hostname = %APPEND% toolbox.com
